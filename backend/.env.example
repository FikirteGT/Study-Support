# Server
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS (leave empty for local development)
CORS_ORIGIN=

# Google Gemini API key (free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Use a model that is currently free AND supports function calling (check AI Studio rate limits page)
GEMINI_MODEL=gemini-2.5-flash

# Random string used to encrypt quiz answer keys (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
QUIZ_SECRET=

# Remote PostgreSQL (Neon / Supabase free tier), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
